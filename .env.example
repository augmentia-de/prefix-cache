# ============================================================
# LLM / OpenAI Configuration (LangChain4j)
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Required — API key for OpenAI
OPENAI_API_KEY=sk-your-api-key-here

# Optional — base URL (for proxies / Azure OpenAI / local dev servers)
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional — model selection
LANGCHAIN4J_OPEN_AI_CHAT_MODEL_MODEL_NAME=gpt-4o

# Optional — temperature (0.0–2.0, higher = more creative)
LANGCHAIN4J_OPEN_AI_CHAT_MODEL_TEMPERATURE=0.7

