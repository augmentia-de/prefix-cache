# Environment secrets
.env
# .env.<name> sind Varianten derselben Sache (z.B. .env.openrouter) und
# enthalten ebenfalls echte Keys. Das Muster muss .env.* sein — ein
# nacktes ".env" trifft nur den exakten Dateinamen.
.env.*
# ...die Vorlage ist ausnahmsweise kein Secret.
!.env.example

# IDE
.idea/
*.iml
.vscode/

# Build
target/
*.class
*.jar

# Request/response exchange logs
logs/
/.env
/target/
/.idea/
/logs/
/wf_prefixcache.md
